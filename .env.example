# UrbanMesh — environment template (aligned with roadmap.md)
# Never commit real secrets. Copy into each app's local .env:
#
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env                # optional
#   cp apps/dashboard/.env.example apps/dashboard/.env    # optional
#
# Pilot corridors (seed + Phase 1–2): Argwings Kodhek · Kirichwa Kubwa
# See roadmap.md for phase exit criteria.

# ═══════════════════════════════════════════════════════════════════════════
# API — apps/api/.env
# ═══════════════════════════════════════════════════════════════════════════

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanmesh?schema=public"
PORT=3001
NODE_ENV=development

# Browser origins for citizen PWA (:5173) + county dashboard (:5174)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ── Clustering (roadmap Wk 6 — must stay configurable, not hard-coded) ─────
# Default self-verify rule: ≥3 same-category reports within 15 m → verified.
# Tune against real corridor density during the community pilot.
CLUSTER_RADIUS_METERS=15
CLUSTER_THRESHOLD=3

# ── Phase 1 hardening — photo upload storage ───────────────────────────────
# Local disk for MVP. POST /api/v1/uploads/photos accepts multipart JPEG/PNG/WebP (2 MB).
PHOTO_STORAGE_PATH="./storage/photos"
PHOTO_PUBLIC_BASE_URL=""

# ── Phase 1 hardening — rate limiting (uploads + reports per window) ───────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REPORTS=10

# ── LPDP Policy PDF (Phase 2 Wk 8) ─────────────────────────────────────────
LPDP_STORAGE_DIR="./storage/lpdp"

# ═══════════════════════════════════════════════════════════════════════════
# Citizen PWA — apps/web/.env  (leave VITE_API_BASE empty to use Vite proxy)
# ═══════════════════════════════════════════════════════════════════════════

# VITE_API_BASE=http://localhost:3001
VITE_H3_RESOLUTION=10

# ═══════════════════════════════════════════════════════════════════════════
# County dashboard — apps/dashboard/.env
# ═══════════════════════════════════════════════════════════════════════════

# VITE_API_BASE=http://localhost:3001
