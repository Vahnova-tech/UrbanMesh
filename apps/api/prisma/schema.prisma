generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum HazardCategory {
  /// Potholes, cracked asphalt, broken paving, and other roadway surface failures
  MOBILITY_SURFACE_DAMAGE
  /// Obstructed walkways, missing crosswalks, and non-motorized transport barriers
  NMT_PEDESTRIAN_HAZARD
  /// Flooded roads, clogged drains, and stormwater runoff hazards
  DRAINAGE_STORMWATER
  /// Open manholes, leaking sewer lines, and exposed sanitation infrastructure
  SEWER_SANITATION
  /// Unlit streets, broken streetlights, and dark corridors affecting personal safety
  LIGHTING_SECURITY
  /// Informal dumping sites and roadside waste accumulation blocking mobility paths
  ILLEGAL_WASTE_DUMP
}

/// Admin workflow status — separate from spatial community corroboration (is_verified).
enum ReviewStatus {
  PENDING
  APPROVED
  /// @deprecated Prefer DISPROVED for moderated invalid claims
  REJECTED
  FLAGGED
  RESOLVED
  ARCHIVED
  /// Admin disproved the hazard claim; evidence retained for audit
  DISPROVED
  /// Admin actively reviewing (not yet decided)
  UNDER_REVIEW
}

model Incident {
  id          String         @id @default(uuid()) @db.Uuid
  category    HazardCategory
  description String
  /// Native PostGIS point (SRID 4326) for GPS longitude/latitude
  location    Unsupported("geometry(Point, 4326)")
  /// Uber H3 cell index for hexagonal spatial aggregation and heatmap clustering
  h3Index     String         @map("h3_index")
  /// Crowdsource spatial corroboration (≥3 same-category within 15 m) — not field inspection
  verified    Boolean        @default(false) @map("is_verified")
  /// Shared cluster anchor for grouping verified incidents; null until clustered
  clusterId   String?        @map("cluster_id") @db.Uuid
  /// Reserved for future PWA photo upload (URL or object key)
  photoUrl    String?        @map("photo_url")
  /// Admin workflow status
  reviewStatus ReviewStatus  @default(PENDING) @map("review_status")
  reviewedAt  DateTime?      @map("reviewed_at")
  reviewNote  String?        @map("review_note")
  /// True only after an admin records an on-site inspection (not auto from community support)
  fieldVerified Boolean      @default(false) @map("field_verified")
  fieldVerifiedAt DateTime?  @map("field_verified_at")
  resolvedAt  DateTime?      @map("resolved_at")
  resolutionNote String?     @map("resolution_note")
  /// If set, this report is treated as a duplicate of another incident
  duplicateOfId String?      @map("duplicate_of_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([h3Index])
  @@index([reviewStatus])
  @@index([duplicateOfId])
  @@map("incidents")
}

/// Planning neighbourhood — Kilimani and Kileleshwa stay separate products.
enum NeighbourhoodId {
  kilimani
  kileleshwa
}

enum DatasetAccessTier {
  open
  restricted
  synthetic
}

enum DatasetDataKind {
  real
  derived
  synthetic
  reference
}

enum ConcernEvidenceType {
  community
  field
  public_doc
  derived
  official
  synthetic
}

enum ConcernReviewStatus {
  under_review
  accepted
  rejected
  archived
}

model Neighbourhood {
  id              NeighbourhoodId @id
  displayName     String          @map("display_name")
  centerLat       Float           @map("center_lat")
  centerLng       Float           @map("center_lng")
  /// Provisional bbox JSON: [minLat, maxLat, minLng, maxLng]
  bboxJson        String          @map("bbox_json")
  boundaryStatus  String          @map("boundary_status")
  boundarySource  String          @map("boundary_source")
  boundaryNote    String          @map("boundary_note")
  /// Optional PostGIS multipolygon (SRID 4326). Not managed by Prisma migrations — set via SQL.
  boundaryGeom    Unsupported("geometry(MultiPolygon,4326)")? @map("boundary_geom")
  boundaryVersion String?         @map("boundary_version")
  reportingMode   String          @map("reporting_mode")
  description     String
  active          Boolean         @default(true)
  datasets        Dataset[]
  dataPacks       DataPack[]
  concernTypes    ConcernType[]
  mapLayers       MapLayer[]
  concerns        Concern[]
  planningDocs    PlanningDocument[]
  changeObservations ChangeObservation[]
  proposals       ParticipantProposal[]

  @@map("neighbourhoods")
}

model Dataset {
  id                    String            @id @default(uuid()) @db.Uuid
  neighbourhoodId       NeighbourhoodId   @map("neighbourhood_id")
  slug                  String
  title                 String
  description           String
  category              String
  geographicCoverage    String            @map("geographic_coverage")
  sourceOrganization    String            @map("source_organization")
  sourceUrl             String?           @map("source_url")
  publishedAt           DateTime?         @map("published_at")
  acquiredAt            DateTime?         @map("acquired_at")
  observationPeriod     String?           @map("observation_period")
  lastUpdated           DateTime?         @map("last_updated")
  fileFormat            String?           @map("file_format")
  license               String
  accessTier            DatasetAccessTier @map("access_tier")
  privacyClassification String            @map("privacy_classification")
  qualityNotes          String            @map("quality_notes")
  methodology           String?
  downloadAvailable     Boolean           @default(false) @map("download_available")
  dataKind              DatasetDataKind   @map("data_kind")
  published             Boolean           @default(false)
  storagePath           String?           @map("storage_path")
  originalFilename      String?           @map("original_filename")
  validationJson        String?           @map("validation_json")
  relatedLayersJson     String?           @map("related_layers_json")
  replaceOfId           String?           @map("replace_of_id") @db.Uuid
  neighbourhood         Neighbourhood     @relation(fields: [neighbourhoodId], references: [id])
  accessLogs            DataAccessLog[]

  @@unique([neighbourhoodId, slug])
  @@index([neighbourhoodId, accessTier])
  @@map("datasets")
}

model DataPack {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  version         String
  title           String
  status          String          @default("draft")
  publishedAt     DateTime?       @map("published_at")
  summary         String?
  methodology     String?
  /// JSON: selected dataset ids, layer keys, narrative overrides
  contentJson     String?         @map("content_json")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@unique([neighbourhoodId, version])
  @@map("data_packs")
}

model ConcernType {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  code            String
  label           String
  description     String
  sortOrder       Int             @default(0) @map("sort_order")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])
  concerns        Concern[]

  @@unique([neighbourhoodId, code])
  @@map("concern_types")
}

model MapLayer {
  id                String          @id @default(uuid()) @db.Uuid
  neighbourhoodId   NeighbourhoodId @map("neighbourhood_id")
  layerKey          String          @map("layer_key")
  title             String
  category          String
  source            String
  attribution       String
  observationPeriod String?         @map("observation_period")
  accessTier        DatasetAccessTier @default(open) @map("access_tier")
  published         Boolean         @default(false)
  featureCount      Int             @default(0) @map("feature_count")
  storagePath       String?         @map("storage_path")
  refreshedAt       DateTime?       @map("refreshed_at")
  neighbourhood     Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@unique([neighbourhoodId, layerKey])
  @@index([neighbourhoodId, published])
  @@map("map_layers")
}

model Concern {
  id               String              @id @default(uuid()) @db.Uuid
  neighbourhoodId  NeighbourhoodId     @map("neighbourhood_id")
  concernTypeCode  String              @map("concern_type_code")
  title            String
  description      String
  evidenceType     ConcernEvidenceType @map("evidence_type")
  reviewStatus     ConcernReviewStatus @default(under_review) @map("review_status")
  reviewNote       String?             @map("review_note")
  reviewedAt       DateTime?           @map("reviewed_at")
  /// Generalized public point (SRID 4326); may be null for sensitive types
  location         Unsupported("geometry(Point, 4326)")?
  areaLabel        String?             @map("area_label")
  observedAt       DateTime?           @map("observed_at")
  sourceRef        String?             @map("source_ref")
  limitations      String?
  researchQuestions String?            @map("research_questions")
  synthetic        Boolean             @default(false)
  createdAt        DateTime            @default(now()) @map("created_at")
  neighbourhood    Neighbourhood       @relation(fields: [neighbourhoodId], references: [id])
  concernType      ConcernType         @relation(fields: [neighbourhoodId, concernTypeCode], references: [neighbourhoodId, code])

  @@index([neighbourhoodId, reviewStatus])
  @@index([neighbourhoodId, concernTypeCode])
  @@map("concerns")
}

model DataAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  datasetId String   @map("dataset_id") @db.Uuid
  actor     String
  action    String
  createdAt DateTime @default(now()) @map("created_at")
  dataset   Dataset  @relation(fields: [datasetId], references: [id])

  @@index([datasetId])
  @@index([createdAt])
  @@map("data_access_logs")
}

model PlanningDocument {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  title           String
  sourceUrl       String?         @map("source_url")
  documentDate    DateTime?       @map("document_date")
  summary         String?
  published       Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@index([neighbourhoodId])
  @@map("planning_documents")
}

model ChangeObservation {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  title           String
  observedAt      DateTime?       @map("observed_at")
  sourceUrl       String?         @map("source_url")
  notes           String?
  beforeImageRef  String?         @map("before_image_ref")
  afterImageRef   String?         @map("after_image_ref")
  published       Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@index([neighbourhoodId])
  @@map("change_observations")
}

model ParticipantProposal {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  title           String
  problemStatement String         @map("problem_statement")
  interpretation  String
  published       Boolean         @default(false)
  createdAt       DateTime        @default(now()) @map("created_at")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@index([neighbourhoodId])
  @@map("participant_proposals")
}

/// Append-only admin action log — never silently rewrite verification history.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String?  @map("incident_id") @db.Uuid
  action     String
  actor      String   @default("admin")
  reason     String?
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
