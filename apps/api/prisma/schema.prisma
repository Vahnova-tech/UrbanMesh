generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum HazardCategory {
  /// Potholes, cracked asphalt, broken paving, and other roadway surface failures
  MOBILITY_SURFACE_DAMAGE
  /// Obstructed walkways, missing crosswalks, and non-motorized transport barriers
  NMT_PEDESTRIAN_HAZARD
  /// Flooded roads, clogged drains, and stormwater runoff hazards
  DRAINAGE_STORMWATER
  /// Open manholes, leaking sewer lines, and exposed sanitation infrastructure
  SEWER_SANITATION
  /// Unlit streets, broken streetlights, and dark corridors affecting personal safety
  LIGHTING_SECURITY
  /// Informal dumping sites and roadside waste accumulation blocking mobility paths
  ILLEGAL_WASTE_DUMP
}

/// Admin workflow status — separate from spatial community corroboration (is_verified).
enum ReviewStatus {
  PENDING
  APPROVED
  /// @deprecated Prefer DISPROVED for moderated invalid claims
  REJECTED
  FLAGGED
  RESOLVED
  ARCHIVED
  /// Admin disproved the hazard claim; evidence retained for audit
  DISPROVED
  /// Admin actively reviewing (not yet decided)
  UNDER_REVIEW
}

model Incident {
  id          String         @id @default(uuid()) @db.Uuid
  category    HazardCategory
  description String
  /// Native PostGIS point (SRID 4326) for GPS longitude/latitude
  location    Unsupported("geometry(Point, 4326)")
  /// Uber H3 cell index for hexagonal spatial aggregation and heatmap clustering
  h3Index     String         @map("h3_index")
  /// Crowdsource spatial corroboration (≥3 same-category within 15 m) — not field inspection
  verified    Boolean        @default(false) @map("is_verified")
  /// Shared cluster anchor for grouping verified incidents; null until clustered
  clusterId   String?        @map("cluster_id") @db.Uuid
  /// Reserved for future PWA photo upload (URL or object key)
  photoUrl    String?        @map("photo_url")
  /// Admin workflow status
  reviewStatus ReviewStatus  @default(PENDING) @map("review_status")
  reviewedAt  DateTime?      @map("reviewed_at")
  reviewNote  String?        @map("review_note")
  /// True only after an admin records an on-site inspection (not auto from community support)
  fieldVerified Boolean      @default(false) @map("field_verified")
  fieldVerifiedAt DateTime?  @map("field_verified_at")
  resolvedAt  DateTime?      @map("resolved_at")
  resolutionNote String?     @map("resolution_note")
  /// If set, this report is treated as a duplicate of another incident
  duplicateOfId String?      @map("duplicate_of_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([h3Index])
  @@index([reviewStatus])
  @@index([duplicateOfId])
  @@map("incidents")
}

/// Planning neighbourhood — Kilimani and Kileleshwa stay separate products.
enum NeighbourhoodId {
  kilimani
  kileleshwa
}

enum DatasetAccessTier {
  open
  restricted
  synthetic
}

enum DatasetDataKind {
  real
  derived
  synthetic
  reference
}

model Neighbourhood {
  id              NeighbourhoodId @id
  displayName     String          @map("display_name")
  centerLat       Float           @map("center_lat")
  centerLng       Float           @map("center_lng")
  /// Provisional bbox JSON: [minLat, maxLat, minLng, maxLng]
  bboxJson        String          @map("bbox_json")
  boundaryStatus  String          @map("boundary_status")
  boundarySource  String          @map("boundary_source")
  boundaryNote    String          @map("boundary_note")
  reportingMode   String          @map("reporting_mode")
  description     String
  active          Boolean         @default(true)
  datasets        Dataset[]
  dataPacks       DataPack[]
  concernTypes    ConcernType[]

  @@map("neighbourhoods")
}

model Dataset {
  id                    String            @id @default(uuid()) @db.Uuid
  neighbourhoodId       NeighbourhoodId   @map("neighbourhood_id")
  slug                  String
  title                 String
  description           String
  category              String
  geographicCoverage    String            @map("geographic_coverage")
  sourceOrganization    String            @map("source_organization")
  sourceUrl             String?           @map("source_url")
  publishedAt           DateTime?         @map("published_at")
  acquiredAt            DateTime?         @map("acquired_at")
  observationPeriod     String?           @map("observation_period")
  lastUpdated           DateTime?         @map("last_updated")
  fileFormat            String?           @map("file_format")
  license               String
  accessTier            DatasetAccessTier @map("access_tier")
  privacyClassification String            @map("privacy_classification")
  qualityNotes          String            @map("quality_notes")
  methodology           String?
  downloadAvailable     Boolean           @default(false) @map("download_available")
  dataKind              DatasetDataKind   @map("data_kind")
  published             Boolean           @default(false)
  neighbourhood         Neighbourhood     @relation(fields: [neighbourhoodId], references: [id])

  @@unique([neighbourhoodId, slug])
  @@index([neighbourhoodId, accessTier])
  @@map("datasets")
}

model DataPack {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  version         String
  title           String
  status          String          @default("draft")
  publishedAt     DateTime?       @map("published_at")
  summary         String?
  methodology     String?
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@unique([neighbourhoodId, version])
  @@map("data_packs")
}

model ConcernType {
  id              String          @id @default(uuid()) @db.Uuid
  neighbourhoodId NeighbourhoodId @map("neighbourhood_id")
  code            String
  label           String
  description     String
  sortOrder       Int             @default(0) @map("sort_order")
  neighbourhood   Neighbourhood   @relation(fields: [neighbourhoodId], references: [id])

  @@unique([neighbourhoodId, code])
  @@map("concern_types")
}

/// Append-only admin action log — never silently rewrite verification history.
model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  incidentId String?  @map("incident_id") @db.Uuid
  action     String
  actor      String   @default("admin")
  reason     String?
  beforeJson String?  @map("before_json")
  afterJson  String?  @map("after_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([incidentId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}
