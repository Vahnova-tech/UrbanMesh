# Copy to apps/api/.env — values aligned with roadmap.md (never commit secrets).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbanmesh?schema=public"
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Citizen PWA + county dashboard + admin panel origins (applied in Express).
# Render also allows the service URL via RENDER_EXTERNAL_URL.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,https://urbanmesh.space"

# Admin moderation panel (Authorization: Bearer …).
# Required in production. Local fallback is urbanmesh-admin-dev only when NODE_ENV≠production.
ADMIN_API_TOKEN="urbanmesh-admin-dev"
# ADMIN_DIST=

# Clustering — wired. Roadmap Wk 6: tune against real corridor density.
# Default: ≥3 same-category citizen reports within 15 m → auto-verify
CLUSTER_RADIUS_METERS=15
CLUSTER_THRESHOLD=3

# Phase 1 — photo upload (multipart field "photo", JPEG/PNG/WebP, max 2 MB)
PHOTO_STORAGE_PATH="./storage/photos"
PHOTO_PUBLIC_BASE_URL=""

# Applied to POST /api/v1/uploads/photos and POST /api/v1/reports
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REPORTS=10

# LPDP PDF output. On Render the blueprint mounts /var/data.
LPDP_STORAGE_DIR="./storage/lpdp"
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# WEB_DIST=
# DASHBOARD_DIST=
