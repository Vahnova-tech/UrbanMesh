{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "sh ../../scripts/vercel-citizen-install.sh",
  "buildCommand": "sh ../../scripts/vercel-citizen-build.sh",
  "outputDirectory": "dist",
  "env": {
    "API_ORIGIN": "https://urbanmesh-vitx.onrender.com"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://urbanmesh-vitx.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://urbanmesh-vitx.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|icons/|api/|uploads/|sw\\.js|manifest\\.webmanifest|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
