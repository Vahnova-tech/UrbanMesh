{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/__file/uploads/:path*"
    },
    {
      "source": "/((?!assets/|icons/|api/|uploads/|sw\\.js|manifest\\.webmanifest|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
