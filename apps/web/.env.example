# Copy to apps/web/.env (optional).
# Leave VITE_API_BASE empty when using `npm run dev` (proxies /api → :3001).
# On Vercel, leave it empty — /api and /uploads rewrite to Render.
# VITE_API_BASE=http://localhost:3001

# VITE_API_BASE=http://localhost:3001

# Street-scale H3 cell resolution for GPS → spatial index (roadmap Wk 2)
VITE_H3_RESOLUTION=10
