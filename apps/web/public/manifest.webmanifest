{
  "id": "urbanmesh-kilimani",
  "name": "UrbanMesh Kilimani",
  "short_name": "UrbanMesh",
  "description": "Report Kilimani walkability and safety hazards for Nairobi County planning.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "background_color": "#F4F1EA",
  "theme_color": "#2F6B5A",
  "lang": "en-KE",
  "dir": "ltr",
  "orientation": "any",
  "categories": ["utilities", "government"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Report a hazard",
      "short_name": "Report",
      "url": "/report",
      "description": "Photograph and log a Kilimani street hazard."
    },
    {
      "name": "Open the map",
      "short_name": "Map",
      "url": "/",
      "description": "View verified clusters and pending reports."
    }
  ]
}
